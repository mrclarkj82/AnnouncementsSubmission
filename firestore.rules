rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function validDoralEmail(value) {
      return value is string
        && value == value.lower()
        && (
          value.matches('^[^@]+@doralacademynv\\.org$')
          || value.matches('^[^@]+@student\\.doralacademynv\\.org$')
        );
    }

    function isTeacherEmail() {
      return hasEmail() && signedInEmail().matches('^[^@]+@doralacademynv\\.org$');
    }

    function isStudentEmail() {
      return hasEmail() && signedInEmail().matches('^[^@]+@student\\.doralacademynv\\.org$');
    }

    function isAllowedDoralEmail() {
      return isTeacherEmail() || isStudentEmail();
    }

    function isRequiredAdmin() {
      return hasEmail()
        && signedInEmail() in [
          "joseph.clark@doralacademynv.org",
          "koby.walsh@doralacademynv.org"
        ];
    }

    function authorizedUserPath(userEmail) {
      return /databases/$(database)/documents/authorizedUsers/$(userEmail);
    }

    function hasAssignedRole(roleValue) {
      return isAllowedDoralEmail()
        && exists(authorizedUserPath(signedInEmail()))
        && get(authorizedUserPath(signedInEmail())).data.email == signedInEmail()
        && get(authorizedUserPath(signedInEmail())).data.active == true
        && get(authorizedUserPath(signedInEmail())).data.role == roleValue;
    }

    function role() {
      return isRequiredAdmin() || hasAssignedRole("admin")
        ? "admin"
        : (
          hasAssignedRole("studioCrew")
            ? "studioCrew"
            : (isTeacherEmail() ? "teacher" : "accessDenied")
        );
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isStudioCrew() {
      return role() == "studioCrew";
    }

    function isStaff() {
      return isAdmin() || isStudioCrew();
    }

    function hasAppAccess() {
      return isStaff() || role() == "teacher";
    }

    function videoUserPath(userEmail) {
      return /databases/$(database)/documents/videoUsers/$(userEmail);
    }

    function hasVideoAssignedRole(roleValue) {
      return isAllowedDoralEmail()
        && exists(videoUserPath(signedInEmail()))
        && get(videoUserPath(signedInEmail())).data.email == signedInEmail()
        && get(videoUserPath(signedInEmail())).data.active == true
        && get(videoUserPath(signedInEmail())).data.role == roleValue;
    }

    function videoRole() {
      return isRequiredAdmin() || hasVideoAssignedRole("admin")
        ? "admin"
        : (
          hasVideoAssignedRole("teacher")
            ? "teacher"
            : (
              hasVideoAssignedRole("student")
                ? "student"
                : (
                  isTeacherEmail()
                    ? "teacher"
                    : (isStudentEmail() ? "student" : "accessDenied")
                )
            )
        );
    }

    function isVideoAdmin() {
      return videoRole() == "admin";
    }

    function isVideoTeacher() {
      return videoRole() == "teacher";
    }

    function isVideoStudent() {
      return videoRole() == "student";
    }

    function hasVideoAccess() {
      return isVideoAdmin() || isVideoTeacher() || isVideoStudent();
    }

    function canSubmitAnnouncements() {
      return isTeacherEmail();
    }

    function validAssignedRole(value) {
      return value in ["admin", "studioCrew"];
    }

    function validVideoRole(value) {
      return value in ["admin", "teacher", "student"];
    }

    function validAnnouncementRole(value) {
      return value in ["admin", "studioCrew", "teacher"];
    }

    function validAnnouncementStatus(value) {
      return value in [
        "Submitted",
        "Approved",
        "Needs Revision",
        "Aired",
        "Skipped",
        "Archived",
        "Rejected"
      ];
    }

    function validRundownStatus(value) {
      return value in ["Draft", "Finalized", "Archived"];
    }

    function validVideoProjectStatus(value) {
      return value in ["active", "paused", "complete", "archived"];
    }

    function validAuthorizedUser(userEmail) {
      return request.resource.data.keys().hasOnly([
          "email",
          "role",
          "active",
          "createdAt",
          "createdBy",
          "updatedAt"
        ])
        && request.resource.data.email == userEmail
        && validDoralEmail(request.resource.data.email)
        && validAssignedRole(request.resource.data.role)
        && request.resource.data.active is bool
        && request.resource.data.createdBy is string;
    }

    function validVideoUser(userEmail) {
      return request.resource.data.keys().hasOnly([
          "email",
          "role",
          "active",
          "createdAt",
          "createdBy",
          "updatedAt"
        ])
        && request.resource.data.email == userEmail
        && validDoralEmail(request.resource.data.email)
        && validVideoRole(request.resource.data.role)
        && request.resource.data.active is bool
        && request.resource.data.createdBy is string;
    }

    function ownsAnnouncement() {
      return isTeacherEmail() && resource.data.submittedByEmail == signedInEmail();
    }

    function videoProjectPath(projectId) {
      return /databases/$(database)/documents/videoProjects/$(projectId);
    }

    function periodPath(periodId) {
      return /databases/$(database)/documents/periods/$(periodId);
    }

    function periodJoinCodePath(codeId) {
      return /databases/$(database)/documents/periodJoinCodes/$(codeId);
    }

    function periodEnrollmentPath(periodId, studentId) {
      return /databases/$(database)/documents/periodEnrollments/$(periodId + "_" + studentId);
    }

    function periodEnrollmentEmailPath(periodId, studentEmail) {
      return /databases/$(database)/documents/periodEnrollments/$(periodId + "_" + studentEmail);
    }

    function canManagePeriodData(periodData) {
      return isVideoAdmin()
        || (isVideoTeacher() && periodData.teacherId == request.auth.uid);
    }

    function canManagePeriodId(periodId) {
      return isVideoAdmin()
        || (
          exists(periodPath(periodId))
          && isVideoTeacher()
          && get(periodPath(periodId)).data.teacherId == request.auth.uid
        );
    }

    function hasActiveUidPeriodEnrollment(periodId) {
      return periodId is string
        && exists(periodEnrollmentPath(periodId, request.auth.uid))
        && get(periodEnrollmentPath(periodId, request.auth.uid)).data.active == true
        && get(periodEnrollmentPath(periodId, request.auth.uid)).data.studentId == request.auth.uid
        && get(periodEnrollmentPath(periodId, request.auth.uid)).data.studentEmail == signedInEmail();
    }

    function hasActiveEmailPeriodEnrollment(periodId) {
      return periodId is string
        && exists(periodEnrollmentEmailPath(periodId, signedInEmail()))
        && get(periodEnrollmentEmailPath(periodId, signedInEmail())).data.active == true
        && get(periodEnrollmentEmailPath(periodId, signedInEmail())).data.studentEmail == signedInEmail();
    }

    function hasActivePeriodEnrollment(periodId) {
      return isVideoStudent()
        && (
          hasActiveUidPeriodEnrollment(periodId)
          || hasActiveEmailPeriodEnrollment(periodId)
        );
    }

    function isAssignedVideoTeacher(projectData) {
      return isVideoTeacher()
        && (
          projectData.assignedTeacherEmail == signedInEmail()
          || projectData.teacherId == request.auth.uid
        );
    }

    function isAssignedVideoStudent(projectData) {
      return isVideoStudent()
        && (
          (
            projectData.assignedStudentEmails is list
            && signedInEmail() in projectData.assignedStudentEmails
          )
          || hasActivePeriodEnrollment(projectData.periodId)
        );
    }

    function canReadVideoProject(projectData) {
      return isVideoAdmin()
        || isAssignedVideoTeacher(projectData)
        || isAssignedVideoStudent(projectData);
    }

    function canReadVideoProjectId(projectId) {
      return exists(videoProjectPath(projectId))
        && canReadVideoProject(get(videoProjectPath(projectId)).data);
    }

    function canManageVideoProjectId(projectId) {
      return exists(videoProjectPath(projectId))
        && (
          isVideoAdmin()
          || isAssignedVideoTeacher(get(videoProjectPath(projectId)).data)
        );
    }

    function validVideoProjectBase() {
      return request.resource.data.assignedTeacherEmail is string
        && request.resource.data.assignedTeacherEmail.matches('^[^@]+@doralacademynv\\.org$')
        && request.resource.data.assignedStudentEmails is list
        && request.resource.data.periodId is string
        && (
          !request.resource.data.keys().hasAny(["periodIds"])
          || (
            request.resource.data.periodIds is list
            && request.resource.data.periodIds.size() > 0
            && request.resource.data.periodIds.hasAll([request.resource.data.periodId])
          )
        )
        && validVideoProjectStatus(request.resource.data.status);
    }

    function validProjectGroupWorkflow(workflowId) {
      return request.resource.data.keys().hasOnly([
          "workflowId",
          "projectId",
          "periodId",
          "groupId",
          "projectTitle",
          "periodName",
          "groupName",
          "assignedStudentEmails",
          "assignedStudentNames",
          "filmingStatus",
          "currentTask",
          "checklistItems",
          "checklistCompletedCount",
          "checklistTotal",
          "submissionUrl",
          "submissionType",
          "submittedAt",
          "submittedBy",
          "submittedByEmail",
          "planningText",
          "studentSelfAssessment",
          "studentSelfAssessmentTotal",
          "studentSelfAssessmentUpdatedAt",
          "studentSelfAssessmentUpdatedBy",
          "studentSelfAssessmentUpdatedByEmail",
          "teacherRubricScores",
          "teacherRubricComplete",
          "teacherRubricTotal",
          "score",
          "maxScore",
          "letterGrade",
          "feedback",
          "privateNotes",
          "feedbackPublished",
          "reviewed",
          "gradedAt",
          "gradedBy",
          "gradedByEmail",
          "unit",
          "updatedAt",
          "updatedBy",
          "updatedByEmail"
        ])
        && request.resource.data.workflowId == workflowId
        && request.resource.data.projectId is string
        && request.resource.data.periodId is string
        && request.resource.data.groupId is string
        && request.resource.data.projectTitle is string
        && request.resource.data.periodName is string
        && request.resource.data.groupName is string
        && request.resource.data.assignedStudentEmails is list
        && request.resource.data.assignedStudentNames is list
        && request.resource.data.filmingStatus is string
        && request.resource.data.currentTask is string
        && request.resource.data.checklistItems is list
        && request.resource.data.checklistCompletedCount is number
        && request.resource.data.checklistTotal is number
        && (!request.resource.data.keys().hasAny(["submissionUrl"]) || request.resource.data.submissionUrl is string)
        && (!request.resource.data.keys().hasAny(["submissionType"]) || request.resource.data.submissionType is string)
        && (!request.resource.data.keys().hasAny(["submittedBy"]) || request.resource.data.submittedBy is string)
        && (!request.resource.data.keys().hasAny(["submittedByEmail"]) || request.resource.data.submittedByEmail is string)
        && (!request.resource.data.keys().hasAny(["planningText"]) || request.resource.data.planningText is string)
        && (!request.resource.data.keys().hasAny(["studentSelfAssessment"]) || request.resource.data.studentSelfAssessment is map)
        && (!request.resource.data.keys().hasAny(["studentSelfAssessmentTotal"]) || request.resource.data.studentSelfAssessmentTotal is number)
        && (!request.resource.data.keys().hasAny(["studentSelfAssessmentUpdatedBy"]) || request.resource.data.studentSelfAssessmentUpdatedBy is string)
        && (!request.resource.data.keys().hasAny(["studentSelfAssessmentUpdatedByEmail"]) || request.resource.data.studentSelfAssessmentUpdatedByEmail is string)
        && (!request.resource.data.keys().hasAny(["teacherRubricScores"]) || request.resource.data.teacherRubricScores is map)
        && (!request.resource.data.keys().hasAny(["teacherRubricComplete"]) || request.resource.data.teacherRubricComplete is map)
        && (!request.resource.data.keys().hasAny(["teacherRubricTotal"]) || request.resource.data.teacherRubricTotal is number)
        && (!request.resource.data.keys().hasAny(["score"]) || request.resource.data.score is string || request.resource.data.score is number)
        && (!request.resource.data.keys().hasAny(["maxScore"]) || request.resource.data.maxScore is string || request.resource.data.maxScore is number)
        && (!request.resource.data.keys().hasAny(["letterGrade"]) || request.resource.data.letterGrade is string)
        && (!request.resource.data.keys().hasAny(["feedback"]) || request.resource.data.feedback is string)
        && (!request.resource.data.keys().hasAny(["privateNotes"]) || request.resource.data.privateNotes is string)
        && (!request.resource.data.keys().hasAny(["feedbackPublished"]) || request.resource.data.feedbackPublished is bool)
        && (!request.resource.data.keys().hasAny(["reviewed"]) || request.resource.data.reviewed is bool)
        && (!request.resource.data.keys().hasAny(["gradedBy"]) || request.resource.data.gradedBy is string)
        && (!request.resource.data.keys().hasAny(["gradedByEmail"]) || request.resource.data.gradedByEmail is string)
        && (!request.resource.data.keys().hasAny(["unit"]) || request.resource.data.unit is number)
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedByEmail is string
        && request.resource.data.updatedByEmail == request.resource.data.updatedByEmail.lower();
    }

    function studentWorkflowCreateIsSafe() {
      return !request.resource.data.keys().hasAny([
        "score",
        "maxScore",
        "letterGrade",
        "feedback",
        "privateNotes",
        "feedbackPublished",
        "reviewed",
        "gradedAt",
        "gradedBy",
        "gradedByEmail",
        "teacherRubricScores",
        "teacherRubricComplete",
        "teacherRubricTotal"
      ]);
    }

    function studentWorkflowUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "filmingStatus",
        "currentTask",
        "checklistItems",
        "checklistCompletedCount",
        "checklistTotal",
        "submissionUrl",
        "submissionType",
        "submittedAt",
        "submittedBy",
        "submittedByEmail",
        "planningText",
        "studentSelfAssessment",
        "studentSelfAssessmentTotal",
        "studentSelfAssessmentUpdatedAt",
        "studentSelfAssessmentUpdatedBy",
        "studentSelfAssessmentUpdatedByEmail",
        "unit",
        "updatedAt",
        "updatedBy",
        "updatedByEmail"
      ]);
    }

    function validProjectGroupPrivateNote(workflowId) {
      return request.resource.data.keys().hasOnly([
          "workflowId",
          "projectId",
          "periodId",
          "groupId",
          "privateNotes",
          "updatedAt",
          "updatedBy",
          "updatedByEmail"
        ])
        && request.resource.data.workflowId == workflowId
        && request.resource.data.projectId is string
        && request.resource.data.periodId is string
        && request.resource.data.groupId is string
        && request.resource.data.privateNotes is string
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedByEmail is string
        && request.resource.data.updatedByEmail == request.resource.data.updatedByEmail.lower();
    }

    function validPeriod(periodId) {
      return request.resource.data.keys().hasOnly([
          "periodId",
          "teacherId",
          "teacherEmail",
          "teacherName",
          "name",
          "className",
          "periodName",
          "periodNumber",
          "courseName",
          "joinCode",
          "joinCodeLowercase",
          "active",
          "archived",
          "archivedAt",
          "archivedBy",
          "seededRoster",
          "seededRosterBatch",
          "createdBySeedScript",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.periodId == periodId
        && request.resource.data.teacherId is string
        && request.resource.data.teacherEmail is string
        && request.resource.data.teacherEmail.matches('^[^@]+@doralacademynv\\.org$')
        && request.resource.data.periodName is string
        && request.resource.data.courseName is string
        && request.resource.data.joinCode is string
        && request.resource.data.joinCodeLowercase is string
        && request.resource.data.active is bool
        && request.resource.data.archived is bool
        && (
          !request.resource.data.keys().hasAny(["name"])
          || request.resource.data.name is string
        )
        && (
          !request.resource.data.keys().hasAny(["className"])
          || request.resource.data.className is string
        )
        && (
          !request.resource.data.keys().hasAny(["periodNumber"])
          || request.resource.data.periodNumber is number
        )
        && (
          !request.resource.data.keys().hasAny(["archivedAt"])
          || request.resource.data.archivedAt is timestamp
          || request.resource.data.archivedAt is string
        )
        && (
          !request.resource.data.keys().hasAny(["archivedBy"])
          || request.resource.data.archivedBy is string
        )
        && (
          !request.resource.data.keys().hasAny(["seededRoster"])
          || request.resource.data.seededRoster is bool
        )
        && (
          !request.resource.data.keys().hasAny(["seededRosterBatch"])
          || request.resource.data.seededRosterBatch is string
        )
        && (
          !request.resource.data.keys().hasAny(["createdBySeedScript"])
          || request.resource.data.createdBySeedScript is bool
        );
    }

    function validPeriodJoinCode(codeId) {
      return request.resource.data.keys().hasOnly([
          "periodId",
          "teacherId",
          "teacherEmail",
          "teacherName",
          "periodName",
          "courseName",
          "joinCode",
          "joinCodeLowercase",
          "active",
          "seededRoster",
          "seededRosterBatch",
          "createdBySeedScript",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.joinCodeLowercase == codeId
        && request.resource.data.periodId is string
        && request.resource.data.teacherId is string
        && request.resource.data.teacherEmail is string
        && request.resource.data.periodName is string
        && request.resource.data.courseName is string
        && request.resource.data.joinCode is string
        && request.resource.data.active is bool
        && (
          !request.resource.data.keys().hasAny(["seededRoster"])
          || request.resource.data.seededRoster is bool
        )
        && (
          !request.resource.data.keys().hasAny(["seededRosterBatch"])
          || request.resource.data.seededRosterBatch is string
        )
        && (
          !request.resource.data.keys().hasAny(["createdBySeedScript"])
          || request.resource.data.createdBySeedScript is bool
        );
    }

    function validPeriodEnrollment(enrollmentId) {
      return request.resource.data.keys().hasOnly([
          "enrollmentId",
          "studentId",
          "seededStudentId",
          "studentEmail",
          "studentName",
          "periodId",
          "periodName",
          "courseName",
          "teacherId",
          "teacherEmail",
          "teacherName",
          "joinCodeLowercase",
          "active",
          "joinedAt",
          "removedAt"
        ])
        && request.resource.data.enrollmentId == enrollmentId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentEmail == signedInEmail()
        && request.resource.data.periodId is string
        && request.resource.data.joinCodeLowercase is string
        && request.resource.data.active == true
        && request.resource.data.removedAt == "";
    }

    function validManualPeriodEnrollment(enrollmentId) {
      return request.resource.data.keys().hasOnly([
          "enrollmentId",
          "studentId",
          "seededStudentId",
          "studentEmail",
          "studentName",
          "periodId",
          "periodName",
          "courseName",
          "teacherId",
          "teacherEmail",
          "teacherName",
          "joinCodeLowercase",
          "active",
          "seededRoster",
          "seededRosterBatch",
          "createdBySeedScript",
          "joinedAt",
          "removedAt"
        ])
        && request.resource.data.enrollmentId == enrollmentId
        && enrollmentId == request.resource.data.periodId + "_" + request.resource.data.studentEmail
        && (
          request.resource.data.studentId == request.resource.data.studentEmail
          || (
            request.resource.data.createdBySeedScript == true
            && request.resource.data.seededRoster == true
            && request.resource.data.seededStudentId is string
            && request.resource.data.studentId == request.resource.data.seededStudentId
          )
        )
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.resource.data.studentEmail.lower()
        && request.resource.data.studentEmail.matches('^[^@]+@student\\.doralacademynv\\.org$')
        && request.resource.data.studentName is string
        && request.resource.data.periodId is string
        && request.resource.data.periodName is string
        && request.resource.data.courseName is string
        && request.resource.data.teacherId is string
        && request.resource.data.teacherEmail is string
        && request.resource.data.teacherName is string
        && request.resource.data.joinCodeLowercase == "manual"
        && request.resource.data.active == true
        && request.resource.data.removedAt == ""
        && (
          !request.resource.data.keys().hasAny(["seededRoster"])
          || request.resource.data.seededRoster is bool
        )
        && (
          !request.resource.data.keys().hasAny(["seededRosterBatch"])
          || request.resource.data.seededRosterBatch is string
        )
        && (
          !request.resource.data.keys().hasAny(["createdBySeedScript"])
          || request.resource.data.createdBySeedScript is bool
        );
    }

    match /authorizedUsers/{userEmail} {
      allow get: if isAdmin()
        || (isAllowedDoralEmail() && userEmail == signedInEmail());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && validAuthorizedUser(userEmail)
        && request.resource.data.createdBy == signedInEmail();
      allow update: if isAdmin()
        && validAuthorizedUser(userEmail)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "active",
          "updatedAt"
        ]);
      allow delete: if isAdmin();
    }

    match /teacherProfiles/{teacherEmail} {
      allow get: if isAdmin()
        || (isTeacherEmail() && teacherEmail == signedInEmail());
      allow list: if isAdmin();
      allow create: if isTeacherEmail()
        && teacherEmail == signedInEmail()
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "firstLoginAt",
          "lastLoginAt"
        ])
        && request.resource.data.email == teacherEmail;
      allow update: if isTeacherEmail()
        && teacherEmail == signedInEmail()
        && request.resource.data.email == resource.data.email
        && request.resource.data.firstLoginAt == resource.data.firstLoginAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "lastLoginAt"
        ]);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if isStaff() || ownsAnnouncement();
      allow create: if canSubmitAnnouncements()
        && request.resource.data.keys().hasOnly([
          "announcementId",
          "submittedByEmail",
          "submittedByName",
          "submittedByRole",
          "title",
          "text",
          "driveVideoLink",
          "requestedAirDate",
          "expirationDate",
          "category",
          "priority",
          "contactName",
          "studioNotes",
          "notesForStudio",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.submittedByEmail == signedInEmail()
        && request.resource.data.submittedByRole == role()
        && validAnnouncementRole(request.resource.data.submittedByRole)
        && request.resource.data.status == "Submitted";
      allow update: if isAdmin()
        && validAnnouncementStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "studioNotes",
          "deletedAt",
          "updatedAt"
        ]);
      allow update: if isStudioCrew()
        && validAnnouncementStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "studioNotes",
          "updatedAt"
        ]);
      allow update: if ownsAnnouncement()
        && resource.data.status in ["Submitted", "Needs Revision"]
        && request.resource.data.submittedByEmail == resource.data.submittedByEmail
        && request.resource.data.status == "Submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "text",
          "driveVideoLink",
          "requestedAirDate",
          "expirationDate",
          "category",
          "priority",
          "contactName",
          "notesForStudio",
          "status",
          "updatedAt"
        ]);
      allow delete: if isAdmin();
    }

    match /rundowns/{rundownId} {
      allow get, list: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.rundownId == rundownId
        && validRundownStatus(request.resource.data.status);
      allow create: if isStudioCrew()
        && request.resource.data.rundownId == rundownId
        && request.resource.data.locked == false
        && validRundownStatus(request.resource.data.status);
      allow update: if isAdmin()
        && validRundownStatus(request.resource.data.status);
      allow update: if isStudioCrew()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "checklistItems",
          "updatedAt"
        ]);
      allow update: if isStudioCrew()
        && resource.data.locked == false
        && request.resource.data.locked == resource.data.locked
        && validRundownStatus(request.resource.data.status);
      allow delete: if isAdmin();
    }

    match /rundownItems/{rundownItemId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /videoUsers/{userEmail} {
      allow get: if isVideoAdmin()
        || (isAllowedDoralEmail() && userEmail == signedInEmail());
      allow list: if isVideoAdmin();
      allow create: if isVideoAdmin()
        && validVideoUser(userEmail)
        && request.resource.data.createdBy == signedInEmail();
      allow update: if isVideoAdmin()
        && validVideoUser(userEmail)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "active",
          "updatedAt"
        ]);
      allow delete: if isVideoAdmin();
    }

    match /periods/{periodId} {
      allow get, list: if isVideoAdmin()
        || canManagePeriodData(resource.data)
        || hasActivePeriodEnrollment(periodId);
      allow create: if isVideoAdmin()
        && validPeriod(periodId);
      allow create: if isVideoTeacher()
        && validPeriod(periodId)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherEmail == signedInEmail();
      allow update: if isVideoAdmin()
        && validPeriod(periodId);
      allow update: if canManagePeriodData(resource.data)
        && validPeriod(periodId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "periodName",
          "courseName",
          "joinCode",
          "joinCodeLowercase",
          "active",
          "archived",
          "archivedAt",
          "archivedBy",
          "updatedAt"
        ]);
      allow delete: if resource.data.archived == true
        && (
          isVideoAdmin()
          || (isVideoTeacher() && resource.data.teacherId == request.auth.uid)
        );
    }

    match /periodJoinCodes/{codeId} {
      allow get: if hasVideoAccess();
      allow list: if isVideoAdmin()
        || (isVideoTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isVideoAdmin()
        && validPeriodJoinCode(codeId)
        && canManagePeriodId(request.resource.data.periodId);
      allow create: if isVideoTeacher()
        && validPeriodJoinCode(codeId)
        && canManagePeriodId(request.resource.data.periodId);
      allow update: if isVideoAdmin()
        && validPeriodJoinCode(codeId)
        && request.resource.data.periodId == resource.data.periodId;
      allow update: if isVideoTeacher()
        && resource.data.teacherId == request.auth.uid
        && validPeriodJoinCode(codeId)
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if isVideoAdmin()
        || (isVideoTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /periodEnrollments/{enrollmentId} {
      allow get, list: if isVideoAdmin()
        || (isVideoTeacher() && resource.data.teacherId == request.auth.uid)
        || (
          isVideoStudent()
          && (
            resource.data.studentId == request.auth.uid
            || resource.data.studentEmail == signedInEmail()
          )
        );
      allow create: if isVideoAdmin()
        && validManualPeriodEnrollment(enrollmentId)
        && exists(periodPath(request.resource.data.periodId))
        && get(periodPath(request.resource.data.periodId)).data.active == true
        && get(periodPath(request.resource.data.periodId)).data.archived == false
        && get(periodPath(request.resource.data.periodId)).data.periodName == request.resource.data.periodName
        && get(periodPath(request.resource.data.periodId)).data.courseName == request.resource.data.courseName
        && get(periodPath(request.resource.data.periodId)).data.teacherId == request.resource.data.teacherId
        && get(periodPath(request.resource.data.periodId)).data.teacherEmail == request.resource.data.teacherEmail
        && get(periodPath(request.resource.data.periodId)).data.teacherName == request.resource.data.teacherName;
      allow create: if isVideoTeacher()
        && validManualPeriodEnrollment(enrollmentId)
        && canManagePeriodId(request.resource.data.periodId)
        && exists(periodPath(request.resource.data.periodId))
        && get(periodPath(request.resource.data.periodId)).data.active == true
        && get(periodPath(request.resource.data.periodId)).data.archived == false
        && get(periodPath(request.resource.data.periodId)).data.periodName == request.resource.data.periodName
        && get(periodPath(request.resource.data.periodId)).data.courseName == request.resource.data.courseName
        && get(periodPath(request.resource.data.periodId)).data.teacherId == request.resource.data.teacherId
        && get(periodPath(request.resource.data.periodId)).data.teacherEmail == request.resource.data.teacherEmail
        && get(periodPath(request.resource.data.periodId)).data.teacherName == request.resource.data.teacherName;
      allow create: if isVideoStudent()
        && validPeriodEnrollment(enrollmentId)
        && enrollmentId == request.resource.data.periodId + "_" + request.auth.uid
        && exists(periodJoinCodePath(request.resource.data.joinCodeLowercase))
        && get(periodJoinCodePath(request.resource.data.joinCodeLowercase)).data.active == true
        && get(periodJoinCodePath(request.resource.data.joinCodeLowercase)).data.periodId == request.resource.data.periodId
        && get(periodJoinCodePath(request.resource.data.joinCodeLowercase)).data.periodName == request.resource.data.periodName
        && get(periodJoinCodePath(request.resource.data.joinCodeLowercase)).data.teacherId == request.resource.data.teacherId
        && exists(periodPath(request.resource.data.periodId))
        && get(periodPath(request.resource.data.periodId)).data.active == true
        && get(periodPath(request.resource.data.periodId)).data.archived == false;
      allow update: if isVideoAdmin();
      allow update: if isVideoTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "removedAt"
        ]);
      allow delete: if isVideoAdmin()
        || (isVideoTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /videoProjects/{projectId} {
      allow get, list: if canReadVideoProject(resource.data);
      allow create: if isVideoAdmin()
        && validVideoProjectBase()
        && canManagePeriodId(request.resource.data.periodId);
      allow create: if isVideoTeacher()
        && validVideoProjectBase()
        && request.resource.data.assignedTeacherEmail == signedInEmail()
        && canManagePeriodId(request.resource.data.periodId);
      allow update: if isVideoAdmin()
        && validVideoProjectBase()
        && canManagePeriodId(request.resource.data.periodId);
      allow update: if isAssignedVideoTeacher(resource.data)
        && validVideoProjectBase()
        && request.resource.data.assignedTeacherEmail == resource.data.assignedTeacherEmail
        && (
          request.resource.data.periodId == resource.data.periodId
          || (
            exists(periodPath(resource.data.periodId))
            && get(periodPath(resource.data.periodId)).data.archived == true
            && get(periodPath(resource.data.periodId)).data.teacherId == request.auth.uid
          )
        )
        && canManagePeriodId(request.resource.data.periodId);
      allow update: if isAssignedVideoStudent(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "checklistItems",
          "scriptSections",
          "shotList",
          "filmingStatus",
          "currentTask",
          "updatedAt",
          "lastActivityAt",
          "lastActivityBy"
        ]);
      allow delete: if isVideoAdmin();
    }

    match /projectGroupWorkflows/{workflowId} {
      allow get: if isVideoAdmin()
        || isVideoTeacher()
        || (
          isVideoStudent()
          && !exists(/databases/$(database)/documents/projectGroupWorkflows/$(workflowId))
        )
        || (
          isVideoStudent()
          && signedInEmail() in resource.data.assignedStudentEmails
          && (
            !resource.data.keys().hasAny(["privateNotes"])
            || resource.data.privateNotes == ""
          )
          && canReadVideoProjectId(resource.data.projectId)
        );
      allow list: if isVideoAdmin() || isVideoTeacher();
      allow create: if validProjectGroupWorkflow(workflowId)
        && canManageVideoProjectId(request.resource.data.projectId);
      allow create: if validProjectGroupWorkflow(workflowId)
        && studentWorkflowCreateIsSafe()
        && isVideoStudent()
        && signedInEmail() in request.resource.data.assignedStudentEmails
        && canReadVideoProjectId(request.resource.data.projectId);
      allow update: if validProjectGroupWorkflow(workflowId)
        && request.resource.data.workflowId == resource.data.workflowId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.groupId == resource.data.groupId
        && canManageVideoProjectId(resource.data.projectId);
      allow update: if validProjectGroupWorkflow(workflowId)
        && studentWorkflowUpdateIsSafe()
        && request.resource.data.workflowId == resource.data.workflowId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.groupId == resource.data.groupId
        && isVideoStudent()
        && signedInEmail() in resource.data.assignedStudentEmails
        && signedInEmail() in request.resource.data.assignedStudentEmails
        && canReadVideoProjectId(resource.data.projectId);
      allow delete: if isVideoAdmin();
    }

    match /projectGroupPrivateNotes/{workflowId} {
      allow get, list: if isVideoAdmin() || isVideoTeacher();
      allow create, update: if validProjectGroupPrivateNote(workflowId)
        && canManageVideoProjectId(request.resource.data.projectId);
      allow delete: if isVideoAdmin()
        || (
          resource.data.projectId is string
          && canManageVideoProjectId(resource.data.projectId)
        );
    }

    match /videoStudentProfiles/{studentEmail} {
      allow get: if isVideoAdmin()
        || isVideoTeacher()
        || (isVideoStudent() && studentEmail == signedInEmail());
      allow list: if isVideoAdmin() || isVideoTeacher();
      allow create, update: if isVideoStudent()
        && studentEmail == signedInEmail()
        && request.resource.data.email == signedInEmail()
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "favoriteMovies",
          "favoriteGames",
          "favoriteMusic",
          "careerGoals",
          "hobbies",
          "favoriteCreators",
          "favoriteSports",
          "productionInterests",
          "updatedAt"
        ]);
      allow delete: if isVideoAdmin();
    }

    match /videoActivityLogs/{logId} {
      allow get, list: if isVideoAdmin() || isVideoTeacher();
      allow create: if hasVideoAccess()
        && request.resource.data.projectId is string
        && canReadVideoProjectId(request.resource.data.projectId)
        && request.resource.data.userEmail == signedInEmail();
      allow update, delete: if isVideoAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if hasAppAccess();
      allow create, update, delete: if isAdmin();
    }

    match /broadcastHistory/{historyId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isAdmin();
    }
  }
}
