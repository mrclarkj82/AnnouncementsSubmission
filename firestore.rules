rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function validDoralEmail(value) {
      return value is string
        && value == value.lower()
        && (
          value.matches('^[^@]+@doralacademynv\\.org$')
          || value.matches('^[^@]+@student\\.doralacademynv\\.org$')
        );
    }

    function isTeacherEmail() {
      return hasEmail() && signedInEmail().matches('^[^@]+@doralacademynv\\.org$');
    }

    function isStudentEmail() {
      return hasEmail() && signedInEmail().matches('^[^@]+@student\\.doralacademynv\\.org$');
    }

    function isAllowedDoralEmail() {
      return isTeacherEmail() || isStudentEmail();
    }

    function authorizedUserPath(userEmail) {
      return /databases/$(database)/documents/authorizedUsers/$(userEmail);
    }

    function hasAssignedRole(roleValue) {
      return isAllowedDoralEmail()
        && exists(authorizedUserPath(signedInEmail()))
        && get(authorizedUserPath(signedInEmail())).data.email == signedInEmail()
        && get(authorizedUserPath(signedInEmail())).data.active == true
        && get(authorizedUserPath(signedInEmail())).data.role == roleValue;
    }

    function role() {
      return hasAssignedRole("admin")
        ? "admin"
        : (
          hasAssignedRole("studioCrew")
            ? "studioCrew"
            : (isTeacherEmail() ? "teacher" : "accessDenied")
        );
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isStudioCrew() {
      return role() == "studioCrew";
    }

    function isStaff() {
      return isAdmin() || isStudioCrew();
    }

    function hasAppAccess() {
      return isStaff() || role() == "teacher";
    }

    function canSubmitAnnouncements() {
      return isTeacherEmail();
    }

    function validAssignedRole(value) {
      return value in ["admin", "studioCrew"];
    }

    function validAnnouncementRole(value) {
      return value in ["admin", "studioCrew", "teacher"];
    }

    function validAnnouncementStatus(value) {
      return value in [
        "Submitted",
        "Approved",
        "Needs Revision",
        "Ready for Broadcast",
        "Aired",
        "Skipped",
        "Archived",
        "Rejected"
      ];
    }

    function validRundownStatus(value) {
      return value in ["Draft", "Finalized", "Archived"];
    }

    function validAuthorizedUser(userEmail) {
      return request.resource.data.keys().hasOnly([
          "email",
          "role",
          "active",
          "createdAt",
          "createdBy",
          "updatedAt"
        ])
        && request.resource.data.email == userEmail
        && validDoralEmail(request.resource.data.email)
        && validAssignedRole(request.resource.data.role)
        && request.resource.data.active is bool
        && request.resource.data.createdBy is string;
    }

    function ownsAnnouncement() {
      return isTeacherEmail() && resource.data.submittedByEmail == signedInEmail();
    }

    match /authorizedUsers/{userEmail} {
      allow get: if isAdmin()
        || (isAllowedDoralEmail() && userEmail == signedInEmail());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && validAuthorizedUser(userEmail)
        && request.resource.data.createdBy == signedInEmail();
      allow update: if isAdmin()
        && validAuthorizedUser(userEmail)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "active",
          "updatedAt"
        ]);
      allow delete: if isAdmin();
    }

    match /teacherProfiles/{teacherEmail} {
      allow get: if isAdmin()
        || (isTeacherEmail() && teacherEmail == signedInEmail());
      allow list: if isAdmin();
      allow create: if isTeacherEmail()
        && teacherEmail == signedInEmail()
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "firstLoginAt",
          "lastLoginAt"
        ])
        && request.resource.data.email == teacherEmail;
      allow update: if isTeacherEmail()
        && teacherEmail == signedInEmail()
        && request.resource.data.email == resource.data.email
        && request.resource.data.firstLoginAt == resource.data.firstLoginAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "lastLoginAt"
        ]);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if isStaff() || ownsAnnouncement();
      allow create: if canSubmitAnnouncements()
        && request.resource.data.keys().hasOnly([
          "announcementId",
          "submittedByEmail",
          "submittedByName",
          "submittedByRole",
          "title",
          "text",
          "driveVideoLink",
          "requestedAirDate",
          "expirationDate",
          "category",
          "priority",
          "contactName",
          "studioNotes",
          "notesForStudio",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.submittedByEmail == signedInEmail()
        && request.resource.data.submittedByRole == role()
        && validAnnouncementRole(request.resource.data.submittedByRole)
        && request.resource.data.status == "Submitted";
      allow update: if isAdmin()
        && validAnnouncementStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "studioNotes",
          "deletedAt",
          "updatedAt"
        ]);
      allow update: if isStudioCrew()
        && validAnnouncementStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "studioNotes",
          "updatedAt"
        ]);
      allow update: if ownsAnnouncement()
        && resource.data.status in ["Submitted", "Needs Revision"]
        && request.resource.data.submittedByEmail == resource.data.submittedByEmail
        && request.resource.data.status == "Submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "text",
          "driveVideoLink",
          "requestedAirDate",
          "expirationDate",
          "category",
          "priority",
          "contactName",
          "notesForStudio",
          "status",
          "updatedAt"
        ]);
      allow delete: if isAdmin();
    }

    match /rundowns/{rundownId} {
      allow get, list: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.rundownId == rundownId
        && validRundownStatus(request.resource.data.status);
      allow create: if isStudioCrew()
        && request.resource.data.rundownId == rundownId
        && request.resource.data.locked == false
        && validRundownStatus(request.resource.data.status);
      allow update: if isAdmin()
        && validRundownStatus(request.resource.data.status);
      allow update: if isStudioCrew()
        && resource.data.locked == false
        && request.resource.data.locked == resource.data.locked
        && validRundownStatus(request.resource.data.status);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if hasAppAccess();
      allow create, update, delete: if isAdmin();
    }

    match /broadcastHistory/{historyId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isAdmin();
    }
  }
}
